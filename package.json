{
  "name": "markdown-editor",
  "displayName": "Markdown Editor",
  "description": "Notion-style WYSIWYG Markdown editor with live formatting",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "markdownEditor.editor",
        "displayName": "Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "markdownEditor.open",
        "title": "Open in Markdown Editor",
        "icon": "$(preview)"
      },
      {
        "command": "markdownEditor.exportPdf",
        "title": "Export to PDF",
        "category": "Markdown Editor",
        "icon": "$(file-pdf)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownEditor.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "markdownEditor.exportPdf",
          "when": "activeCustomEditorId == markdownEditor.editor",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownEditor.exportPdf",
          "when": "activeCustomEditorId == markdownEditor.editor"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Editor",
      "properties": {
        "markdownEditor.pdf.browserPath": {
          "type": "string",
          "default": "",
          "description": "Path to a Chromium-based browser (Chrome, Edge, Chromium) used for PDF export. Leave empty to detect automatically."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run build:webview",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository --skip-license",
    "build:webview": "esbuild webview/main.ts --bundle --minify --format=iife --target=es2022 --outfile=media/dist/editor.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@tiptap/core": "2.27.3",
    "@tiptap/extension-bubble-menu": "^2.27.3",
    "@tiptap/extension-code-block-lowlight": "^2.27.3",
    "@tiptap/extension-image": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/extension-placeholder": "2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "2.27.3",
    "@tiptap/extension-task-list": "2.27.3",
    "@tiptap/pm": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "lowlight": "^3.3.0",
    "tiptap-markdown": "^0.8.10",
    "typescript": "^5.4.0"
  }
}
